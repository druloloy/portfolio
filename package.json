{
  "name": "druloloy-payload",
  "version": "1.0.0",
  "description": "Website template for Payload",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3333",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev -p 3333",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 3333",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "migrate:create": "node scripts/with-session-db.cjs migrate:create",
    "migrate": "node scripts/with-session-db.cjs migrate",
    "migrate:status": "node scripts/with-session-db.cjs migrate:status",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "test": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "test:watch": "cross-env NODE_OPTIONS=--no-deprecation vitest --config ./vitest.config.mts",
    "init_key:dev": "node init_key.cjs -d ./keystore/keyfile.development.json.enc",
    "init_key:prod": "node init_key.cjs -d ./keystore/keyfile.production.json.enc",
    "migrate:down": "node scripts/with-session-db.cjs migrate:down",
    "db:backup": "node scripts/backup-database.cjs",
    "db:dump-schema": "node scripts/dump-schema.cjs",
    "db:drop": "node scripts/drop-payload-schema.cjs",
    "db:restore": "node scripts/restore-content.cjs"
  },
  "dependencies": {
    "@faceless-ui/modal": "3.0.0",
    "@faceless-ui/scroll-info": "2.0.0",
    "@payloadcms/db-postgres": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/payload-cloud": "3.89.0",
    "@payloadcms/plugin-nested-docs": "3.89.0",
    "@payloadcms/plugin-redirects": "3.89.0",
    "@payloadcms/plugin-seo": "3.89.0",
    "@payloadcms/richtext-lexical": "3.89.0",
    "@payloadcms/storage-gcs": "3.89.0",
    "@payloadcms/ui": "3.89.0",
    "aos": "^3.0.0-beta.6",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "escape-html": "^1.0.3",
    "graphql": "^16.8.1",
    "gsap": "^3.12.5",
    "lenis": "^1.1.18",
    "next": "16.3.3",
    "payload": "3.89.0",
    "payload-admin-bar": "^1.0.7",
    "qs": "6.11.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.88.0",
    "react-icons": "^5.3.0",
    "react-slick": "^0.31.0",
    "sharp": "0.34.2",
    "slick-carousel": "^1.8.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "16.3.0",
    "@types/aos": "^3.0.7",
    "@types/escape-html": "^1.0.2",
    "@types/node": "22.19.9",
    "@types/qs": "^6.9.8",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/react-slick": "^0.23.13",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  }
}
