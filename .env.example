# Required. `src/app/sitemap.ts` builds a fetch URL from this value and will
# request http://localhost:undefined if it is unset.
# Run on a specific port
PORT=3000

# Postgres connection string (this project uses @payloadcms/db-postgres)
DATABASE_URI=postgres://user:password@127.0.0.1:5432/portfolio

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to format links and URLs
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Allow robots to index the site (optional)
NEXT_PUBLIC_IS_LIVE=

# Used to preview drafts
NEXT_PRIVATE_DRAFT_SECRET=demo-draft-secret

# Used to revalidate static pages
REVALIDATION_KEY=demo-revalation-key
NEXT_PRIVATE_REVALIDATION_KEY=demo-revalation-key

# Google Cloud Storage — media uploads
# GCS_KEYFILENAME is the filename inside ./keystore, not a path
GCS_BUCKET=
GCS_ENDPOINT=
GCS_PROJECT_ID=
GCS_KEYFILENAME=

# Key File Secret
KEY_FILE_SECRET=32_bit_random_secret

# Used for getting web analytics data
NEXT_PUBLIC_GTM_ID=

# Used for allowing Railway Free Hosting URL to fetch resources (CORS/CSRF)
RAILWAY_SERVER=